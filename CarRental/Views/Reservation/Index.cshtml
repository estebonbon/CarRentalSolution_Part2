@model IEnumerable<CarRental.Models.Reservation>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ReservationNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PickupSummary)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReturnSummary)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Employee.Summary)
            </th>
            <th>
                Location
            </th>
            <th>
                Customer(s)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.ReservationNumber)
                </td>
                <td>
                    @Html.DisplayFor(model => item.PickupSummary)
                </td>
                <td>
                    @Html.DisplayFor(model => item.ReturnSummary)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Status)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Employee.Summary)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Location.Name)
                </td>

                <td>
                    @{
                        int customerCount = item.CustomerReservations.Count;

                        if (customerCount > 0)
                        {
                            var customers = item.CustomerReservations.ToList();

                            string firstCustomer =
                                customers[0].Customer.FirstName + " " +
                                customers[0].Customer.LastName;

                            if (customerCount > 1)
                            {
                                <a role="button"
                                   data-bs-toggle="collapse"
                                   href="#collapseCustomers@(item.ID)"
                                   aria-expanded="false"
                                   aria-controls="collapseCustomers@(item.ID)">

                                    @firstCustomer
                                    <span class="badge bg-info">@customerCount</span>
                                </a>

                                <div class="collapse" id="collapseCustomers@(item.ID)">
                                    @for (int i = 1; i < customerCount; i++)
                                    {
                                        <div>
                                            @customers[i].Customer.FirstName
                                            @customers[i].Customer.LastName
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                @firstCustomer
                            }
                        }
                        else
                        {
                            @:None
                        }
                    }
                </td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
