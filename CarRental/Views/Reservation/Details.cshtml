@model CarRental.Models.Reservation

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Reservation</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ReservationNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ReservationNumber)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PickupSummary)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PickupSummary)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ReturnSummary)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ReturnSummary)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Employee.Summary)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Employee.Summary)
        </dd>
        <dt class="col-sm-2">
            Location
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Location.Name)
        </dd>
        <dt class="col-sm-2">
            Customer(s)
        </dt>
        <dd class="col-sm-10">
            @foreach (var cr in Model.CustomerReservations)
            {
                <div>
                    @cr.Customer.FirstName @cr.Customer.LastName
                </div>
            }
        </dd>

    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.ID">Edit</a> |
    <partial name="_BackToList" />
</div>
