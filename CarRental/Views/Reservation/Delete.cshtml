@model CarRental.Models.Reservation

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this Reservation?</h3>
<div>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ReservationNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ReservationNumber)
        </dd>
    
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PickupSummary)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PickupSummary)
        </dd>
    
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ReturnSummary)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ReturnSummary)
        </dd>
    
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
    
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Employee.Summary)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Employee.Summary)
        </dd>
    
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Location)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Location.Name)
        </dd>

        <dt class="col-sm-2">
            Customers
        </dt>
        <dd class="col-sm-10">
            @foreach (var cr in Model.CustomerReservations)
            {
                <div>
                    @cr.Customer.FirstName @cr.Customer.LastName
                </div>
            }
        </dd>

    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="ID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
