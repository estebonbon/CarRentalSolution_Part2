@model CarRental.Models.Customer

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Customer</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FirstName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FirstName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MiddleName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MiddleName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.LastName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.LastName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PhoneFormatted)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PhoneFormatted)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DriverLicense)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DriverLicense)
        </dd>

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DOB)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DOB)
        </dd>

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MembershipType.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MembershipType.Name)
        </dd>
        <dd class="col-sm-10">
            <table class="table">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.CustomerReservations.FirstOrDefault().Reservation.ReservationNumber)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.CustomerReservations.FirstOrDefault().Reservation.PickupSummary)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.CustomerReservations.FirstOrDefault().Reservation.Status)
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.CustomerReservations)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Reservation"
                                   asp-action="Details"
                                   asp-route-id="@item.ReservationID">
                                    @Html.DisplayFor(modelItem => item.Reservation.ReservationNumber)
                                </a>
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Reservation.PickupSummary)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Reservation.Status)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </dd>

    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.ID">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
